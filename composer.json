{
  "name": "codeinc/strip-accents",
  "description": "A PHP library to remove accents and diacritics from strings",
  "homepage": "https://github.com/codeinchq/strip-accents",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "CodeInc\\StripAccents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CodeInc\\StripAccents\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Joan Fabrégat",
      "email": "joan@codeinc.co",
      "homepage": "https://www.codeinc.co",
      "role": "developer"
    }
  ],
  "config": {
    "preferred-install": {
      "*": "dist"
    }
  }
}
